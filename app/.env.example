NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: for AI-assisted recipe import (URL fallback + photo OCR)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: timeout (ms) for the recipe URL scrape fetch. Default 15000.
# Read by app/src/lib/env.ts and used by the SSRF-safe fetch in src/lib/import/ssrf.ts.
# SCRAPER_TIMEOUT_MS=15000

# --- Observability (all optional; absence => Sentry is a NO-OP) ---
# Public Sentry DSN — safe to expose; enables client + server error tracking.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (set in Vercel/CI env, NEVER in git). Enables source-map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
